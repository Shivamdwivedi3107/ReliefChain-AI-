# Environment Configuration for ReliefChain AI Backend

# Application Settings
PROJECT_NAME="ReliefChain AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL with SQLite fallback support for local sandbox testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reliefchain"

# CORS Configuration (comma separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Blockchain Configuration (EVM / Hardhat local node)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
BLOCKCHAIN_PRIVATE_KEY=""

# AI Model Configuration
AI_MODEL_PATH="app/models/ai/priority_classifier.joblib"
