# ==============================================================================
# ReliefChain AI — Master Environment Configuration Template (.env.example)
# Copy this template to .env and configure secrets according to target tier.
# ==============================================================================

# Application Metadata & Runtime Environment
PROJECT_NAME="ReliefChain AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"       # Options: development, testing, staging, production
DEBUG=True                      # CRITICAL: Must be False in production
HOST="0.0.0.0"
PORT=8000
WORKERS=4                       # Number of ASGI worker processes

# Security & Cryptographic Tokens
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="reliefchain-dev-super-secret-key-change-in-production-12345"
JWT_SECRET_KEY=""               # Optional dedicated JWT signing key (defaults to SECRET_KEY)
ALGORITHM="HS256"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours default token validity

# Network, Hostnames & Security Headers
ALLOWED_HOSTS="*"               # Production example: "api.reliefchain.org,localhost"
DOMAIN_NAME="localhost"         # Domain name for reverse proxy routing

# Database Persistence Engine
# Local Development & Testing Default (SQLite):
DATABASE_URL="sqlite:///./reliefchain.db"
# Optional In-Memory / Test Database URL:
TEST_DATABASE_URL="sqlite:///:memory:"
# Production / Staging PostgreSQL Connection Example:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/reliefchain"

# PostgreSQL Container Credentials Template (Used by Docker Compose)
POSTGRES_DB=reliefchain
POSTGRES_USER=reliefchain_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_PORT=5432

# Cross-Origin Resource Sharing (CORS Whitelist)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000"

# Rate Limiting Engine (Sliding Window Per-IP Quotas)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_QR_PER_MINUTE=60
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=300

# Structured Logging & Telemetry
LOG_LEVEL="INFO"                # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="standard"           # Options: standard (human readable), json (container/cloud)

# AI Decision Support System (DSS) Artifacts
AI_MODEL_PATH="ai/model/priority_classifier.joblib"

# Storage & Upload Parameters
STORAGE_LOCAL_DIR="uploads/evidence"
MAX_UPLOAD_SIZE_MB=10

# Optional Infrastructure Addons
REDIS_URL=""                    # e.g. redis://localhost:6379/0
SENTRY_DSN=""                   # e.g. https://public@sentry.example.com/1

# Blockchain Ledger EVM Connector (Optional)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
BLOCKCHAIN_PRIVATE_KEY=""
