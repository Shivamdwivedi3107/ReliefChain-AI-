# Environment Configuration for ReliefChain AI
PROJECT_NAME="ReliefChain AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & JWT Token Config
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL / SQLite fallback supported)
DATABASE_URL="sqlite:///./reliefchain.db"

# CORS Origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000"

# Blockchain Audit Configuration
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""
BLOCKCHAIN_PRIVATE_KEY=""
